# Copy to .env and adjust. Every value has a default, so .env is optional.

# Only needed for a second copy on the same machine (e.g. another person): give each copy its own name and ports
# COMPOSE_PROJECT_NAME=sanguity-alex

# Ports on this machine: the web app, and the receiver the phone app uploads watch data to
WEB_PORT=8730
RECEIVER_PORT=8731

# Folder holding your record exports (one subfolder per export, named in sources.json)
RECORDS_DIR=./records

# Folder for Sanguity's own data: the database (accounts, profiles, sessions) and each profile's records
DATA_DIR=./data

# Folder for backups (python -m server.manage backup); copy them somewhere off this machine too
BACKUP_DIR=./backups

# Folder where the receiver keeps watch and scale data
WATCH_DIR=./watch-data

# Time zone used to assign watch readings to days, e.g. Europe/London or America/New_York
TZ=UTC

# Your user and group IDs on this machine (run: id -u ; id -g), so files the app writes stay yours
PUID=1000
PGID=1000

# How long a sign-in lasts: this many days on an account with a second factor (an authenticator app or a passkey)...
SESSION_DAYS=30
# ...and this many hours on one without (0 = SESSION_DAYS for everyone)
SESSION_HOURS_WITHOUT_2FA=12
# Also sign people out after this many minutes without using the app (0 = off)
SESSION_IDLE_MINUTES=0

# Mark the session cookie Secure: auto (when your reverse proxy says the request came over HTTPS), 1 or 0
COOKIE_SECURE=auto

# Only if sign-in says "Request refused (cross-site check)" behind your own reverse proxy: the address you open
# Sanguity at, e.g. https://health.example.com (comma-separated for several)
# PUBLIC_ORIGINS=

# An admin who resets a password, turns off someone's two-factor sign-in or makes someone an admin confirms
# it's them (password, code or passkey) unless they did, or signed in, within this many minutes
REAUTH_MINUTES=5

# How many sign-in password checks run at once (each uses 64 MB for a moment); more wait their turn
HASH_PARALLEL=2

# How many days the activity log keeps entries (who opened, shared or changed what)
ACTIVITY_DAYS=365
