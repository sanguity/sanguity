# Copy to .env and adjust. Every value has a default, so .env is optional.

# Release installs only (compose.release.yaml): the version of the published image to run, e.g. 1.2.0. The
# compose file downloaded from a release starts that release; set this to pin or change it
# SANGUITY_VERSION=

# Only needed for a second copy on the same machine (e.g. another person): give each copy its own name and ports
# COMPOSE_PROJECT_NAME=sanguity-alex

# Ports on this machine: the web app, and the receiver the phone app uploads watch data to
WEB_PORT=8730
RECEIVER_PORT=8731

# Folder holding your record exports (one subfolder per export, named in sources.json)
RECORDS_DIR=./records

# Folder for Sanguity's own data: the database (accounts, profiles, sessions) and each profile's records
DATA_DIR=./data

# Release installs only: the folder for the encryption key and the receiver's secret (a checkout install keeps
# them in ./auth), and the folder for sources.json, settings.json and corrections.json
# AUTH_DIR=./auth
# CONFIG_DIR=./config

# Folder for backups (python -m server.manage backup); copy them somewhere off this machine too
BACKUP_DIR=./backups

# Folder where the receiver keeps watch and scale data
WATCH_DIR=./watch-data

# The containers' clock, e.g. Europe/London or America/New_York. (The phone receiver's time zone, for readings that
# don't say their own, is set in the app: Settings → Install → General → Needs a restart; an upgrade takes it from
# here once. What you see in the app follows each person's own time zone, chosen in Settings.)
TZ=UTC

# Your user and group IDs on this machine (run: id -u ; id -g), so files the app writes stay yours
PUID=1000
PGID=1000

# ---- The server's own settings are NOT set here (#1158). As in Sonarr and Radarr, every one of them (public
# addresses, sign-in rules, the Secure cookie, upload and Health Link limits, connected sources, trusted proxies, the
# phone receiver's time zone and days, backups and logging...) is changed in the app, under Settings → Install, and kept
# in the data folder (the database, and data/server-settings.json for those that need a restart).
#
# Upgrading from a version that took them from here: on its first start, each one still set in this file is copied
# into the app once (Install activity says which, and Settings → Install → General says so once). After that a change
# to it here is ignored, with a warning in the app's log naming it: take those lines out at your leisure.
#
# If a value saved in the app locks everyone out:
#   docker compose exec app python -m server.manage config reset NAME     (or --all; config show lists them)
#   docker compose exec app python -m server.manage config set NAME VALUE
# or, for a while, the line below: every value saved in the app is left out (each its default) while it's set
# SANGUITY_SAVED_SETTINGS=off

# ---- Optional: settings you may choose to keep here on purpose (managed by the environment). While one is set it
# wins, and the app shows its row locked, "Managed by the environment"; take it out and the app's own is used again.
# Each may instead be NAME_FILE, the path of a file holding it (a Docker secret, say), read at each use, so a secret
# your secret manager rotates applies without touching the app.
#
# Sign-in provider (Settings → Install → Accounts and sign-in → Sign-in provider)
# OIDC_ISSUER=https://auth.example.com/realms/home
# OIDC_CLIENT_ID=sanguity
# OIDC_CLIENT_SECRET=
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# OIDC_SCOPES=openid email profile
# OIDC_BUTTON=single sign-on
# OIDC_ACR=
# OIDC_ONLY=0
#
# Notifications' access token (Settings → Install → General → Notifications)
# NOTIFY_TOKEN=
