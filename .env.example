# Copy to .env and adjust. Every value has a default, so .env is optional.

# Release installs only (compose.release.yaml): the version of the published image to run, e.g. 1.2.0. The
# compose file downloaded from a release starts that release; set this to pin or change it
# SANGUITY_VERSION=

# Only needed for a second copy on the same machine (e.g. another person): give each copy its own name and ports
# COMPOSE_PROJECT_NAME=sanguity-alex

# Ports on this machine: the web app, and the receiver the phone app uploads watch data to
WEB_PORT=8730
RECEIVER_PORT=8731

# Folder holding your record exports (one subfolder per export, named in sources.json)
RECORDS_DIR=./records

# Folder for Sanguity's own data: the database (accounts, profiles, sessions) and each profile's records
DATA_DIR=./data

# Release installs only: the folder for the encryption key and the receiver's secret (a checkout install keeps
# them in ./auth), and the folder for sources.json, settings.json and corrections.json
# AUTH_DIR=./auth
# CONFIG_DIR=./config

# Folder for backups (python -m server.manage backup); copy them somewhere off this machine too
BACKUP_DIR=./backups

# Folder where the receiver keeps watch and scale data
WATCH_DIR=./watch-data

# Time zone for watch readings when the phone doesn't say its own, e.g. Europe/London or America/New_York.
# (What you see in the app follows each person's own time zone, chosen in Settings.)
TZ=UTC

# Your user and group IDs on this machine (run: id -u ; id -g), so files the app writes stay yours
PUID=1000
PGID=1000

# ---- The server's own settings. Each is commented out, so the app uses the value an admin saved in it, or the
# default shown. One set here is fixed: the app shows it as set in .env, naming it, and can't change it until the
# line is taken out again and the app restarted (docker compose up -d).

# -- Changed on Settings → Install → General (#1120). Leave these commented out and change them there; uncomment one
# only to pin it here.

# Host: the addresses you open Sanguity at, e.g. https://health.example.com (comma-separated for several). Set it here
# when sign-in says "Request refused (cross-site check)" behind your own reverse proxy: the page can't be reached then
# PUBLIC_ORIGINS=

# Phone receiver: the phone app's upload address shown in Settings is
# http://<each PUBLIC_ORIGINS host>:RECEIVER_PORT/ingest (or the address you opened Sanguity at). If the receiver is
# behind your own HTTPS reverse proxy, its address:
# WATCH_UPLOAD_URL=https://watch.example.com/ingest

# Security: how long a sign-in lasts, this many days on an account with a second factor (an authenticator app or a
# passkey)...
# SESSION_DAYS=30
# ...and this many hours on one without (0 = SESSION_DAYS for everyone)
# SESSION_HOURS_WITHOUT_2FA=12
# Also sign people out after this many minutes without using the app (0 = off)
# SESSION_IDLE_MINUTES=0
# The shortest password: while it's the only factor, and with two-factor sign-in on (NIST SP 800-63B)
# PASSWORD_MIN_LENGTH=15
# PASSWORD_MIN_LENGTH_2FA=8
# A one-time password from an admin stops working after this many days
# TEMP_PASSWORD_DAYS=7
# An admin who resets a password, turns off someone's two-factor sign-in or makes someone an admin confirms
# it's them (password, code or passkey) unless they did, or signed in, within this many minutes
# REAUTH_MINUTES=5

# Backups and logging: how many days the activity log keeps entries (who opened, shared or changed what)
# ACTIVITY_DAYS=365

# Experimental: connected sources at all (#1096), off by default (1 on, 0 off)
# CONNECTED_SOURCES=0

# -- Set here only (or their default)

# Mark the session cookie Secure: auto (when your reverse proxy says the request came over HTTPS), 1 or 0
# COOKIE_SECURE=auto

# How many sign-in password checks run at once (each uses 64 MB for a moment); more wait their turn
# HASH_PARALLEL=2

# How many days what a restore replaced (before-restore-<time>/, the app's and the receiver's) is kept before it's
# deleted; it may hold a profile deleted since (#593, #595)
# RESTORE_KEEP_DAYS=30

# How many days the receiver keeps phone data no profile or secret names any more (left by a profile deleted before
# #588) before deleting it (#593)
# SLOT_GRACE_DAYS=7

# Uploads on the Import page. A file is one sent from the browser or one unpacked from a zip; an upload's total
# counts what it holds once its zips are unpacked. nginx.conf caps a file sent at 4096 MB: raise that too to go higher.
# UPLOAD_MAX_FILE_MB=4096
# UPLOAD_MAX_TOTAL_MB=16384
# UPLOAD_MAX_FILES=20000
# A file unpacked from a zip may be at most this many times its compressed size (zip bombs are thousands)
# UPLOAD_MAX_ZIP_RATIO=200
# A photo attached to a journal entry (#161). nginx.conf caps one sent at 25 MB: raise that too to go higher.
# JOURNAL_PHOTO_MAX_MB=20

# Connected sources: how often each connection pulls what's new (hours), the most records one pull fetches, the
# largest attachment any connection fetches (the Sync defaults can't go above it), and how long to wait for a vendor
# (seconds)
# SYNC_HOURS=12
# SYNC_MAX_RESOURCES=20000
# SYNC_MAX_ATTACHMENT_MB=50
# CONNECT_TIMEOUT=30

# SMART Health Links pasted in: the most one link may bring (MB, all of it) and how many files, and how long to wait
# for its server (seconds)
# SHL_MAX_MB=64
# SHL_MAX_FILES=50
# SHL_TIMEOUT=20

# Only to get back in when a setting saved in the app locks everyone out: off leaves every value saved in the app out,
# each setting the environment's or its default. Sign in, put it right in the app, then take this line out again and
# run docker compose up -d. (python -m server.manage config reset SETTING does it without the page.)
# SANGUITY_SAVED_SETTINGS=off
